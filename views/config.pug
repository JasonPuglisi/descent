extends template/layout

block otherStylesheets
  link(href=`${assets}/stylesheets/config.css`, rel='stylesheet')

block content
  .container
    h1= title
    h2#heading-scrobble Scrobble Mode
    div.selectGroups(role='group' aria-labelledby='heading-scrobble' aria-describedby='notice-scrobble')
      div.scrobbleNotice#notice-scrobble Choose whether Descent should display the most recent scrobble or only the currently playing track
      button.selectGroup.groupScrobbleMode#scrobbleMode-lastScrobbled(type='button' aria-pressed='false') Last Scrobbled
      button.selectGroup.groupScrobbleMode#scrobbleMode-currentlyPlaying(type='button' aria-pressed='false') Currently Playing
    h2#heading-bg Background Type
    div.selectGroups(role='group' aria-labelledby='heading-bg')
      button.selectGroup.groupBg#bg-artist(type='button' aria-pressed='false') Artist
      button.selectGroup.groupBg#bg-album(type='button' aria-pressed='false') Album
      button.selectGroup.groupBg#bg-transparent(type='button' aria-pressed='false') Transparent
      button.selectGroup.groupBg#bg-none(type='button' aria-pressed='false') None
    h2#heading-bgopt Background Options
    div.selectGroups(role='group' aria-labelledby='heading-bgopt')
      button.selectGroup.groupBgopt#bgopt-blur(type='button' aria-pressed='false') Blur
      span.inputLine
        small
          label(for='bgopt-default') Default image URL:
          | &nbsp;
          input.inputGroup.groupBgopt#bgopt-default(name='defaultBackground', type='text', size='20', maxlength='300', placeholder='None')
          | &nbsp;
          button.linkButton.backgroundInputSave.hide(type='button')
            i.fas.fa-save.fa-sm(aria-hidden='true')
            |  save
    h2 Weather Location
    div.selectGroups
      span.inputLine
        small
          div.coordinateNotice Find coordinates by right-clicking a location in Google Maps
          label(for='loc-latitude') Latitude:
          | &nbsp;
          input.inputGroup#loc-latitude(name='locationLatitude', type='text', size='12', maxlength='24', placeholder='Automatic')
          label(for='loc-longitude') Longitude:
          | &nbsp;
          input.inputGroup#loc-longitude(name='locationLongitude', type='text', size='12', maxlength='24', placeholder='Automatic')
          | &nbsp;
          button.linkButton.locationInputSave.hide(type='button')
            i.fas.fa-save.fa-sm(aria-hidden='true')
            |  save
    h2#heading-units Weather Units
    div.selectGroups(role='group' aria-labelledby='heading-units')
      button.selectGroup.groupUnits#units-imperial(type='button' aria-pressed='false') Imperial (ºF)
      button.selectGroup.groupUnits#units-metric(type='button' aria-pressed='false') Metric (ºC)
    h2#heading-datetime Time and Date Options
    div.selectGroups(role='group' aria-labelledby='heading-datetime')
      button.selectGroup.groupDatetime#datetime-24hr(type='button' aria-pressed='false') 24-hour time
      button.selectGroup.groupDatetime#datetime-weekday(type='button' aria-pressed='false') Show weekday
      button.selectGroup.groupDatetime#datetime-seconds(type='button' aria-pressed='false') Show seconds
    .links
      a(href='/')
        | home&nbsp;
        i.fas.fa-home.fa-sm(aria-hidden='true')
      a(href='/app/hue')
        | hue settings&nbsp;
        i.fas.fa-lightbulb.fa-sm(aria-hidden='true')

block otherJavascripts
  script(type='module', src=`${assets}/javascripts/config.js`)
