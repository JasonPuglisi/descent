extends template/layout

block otherStylesheets
  link(href=`${assets}/stylesheets/config.css`, rel='stylesheet')

block content
  .container
    h1= title
    div(data-hue-client-id=hueClientId)
      ol
        li.hueStep#loading(role='status')
          h2
            i.fas.fa-circle-notch.fa-spin(aria-hidden='true')
            | Loading...
        li.hide.hueStep#connect
          p.hide#connect-again Hue didn't accept the saved connection, so it needs connecting again.
          h2
            a.appAuth Click here
            |  to connect your Hue account.
        li.hide.hueStep#hue-step-rooms
          h2#heading-rooms Select one or more rooms to control.
          div.hide.selectGroupsLoading#select-groups-loading-rooms(role='status')
            h2
              i.fas.fa-circle-notch.fa-spin(aria-hidden='true')
              | Loading...
          p.hide#no-rooms This Hue account doesn't have any rooms yet. Add some in the Hue app, then come back.
          div.selectGroups#select-groups-rooms(role='group' aria-labelledby='heading-rooms')
        li.hide.hueStep#hue-step-done All set. Hit 
          span.code l
          |  on your now playing page to toggle light control on and off.
    div.hide#hue-options
      h2#heading-color Color Options
      div.selectGroups(role='group' aria-labelledby='heading-color')
        button.selectGroup.groupHue#hue-shuffle(type='button' aria-pressed='false') Shuffle order
    .links
      a(href='/')
        | home 
        i.fas.fa-home.fa-sm(aria-hidden='true')
      a(href='/app/config')
        | settings 
        i.fas.fa-sliders-h.fa-sm(aria-hidden='true')

block otherJavascripts
  script(type='module', src=`${assets}/javascripts/hue.js`, nonce=nonce)
