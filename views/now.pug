extends template/layout

block otherStylesheets
  +weatherIcons
  link(href=`${assets}/stylesheets/now.css`, rel='stylesheet')

block content
  .background.blur
  .pageData.hide(data-user=user, data-version=version)
  .container
    .row.top
      .corner.left
        .datetime.hide
          h2.date
          h1.time
      .corner.right
        .weather.hide
          h2.summary
          h1.conditions
            i.icon
            | &nbsp;
            span.temperature
            | &deg;
            span.unit
            | &nbsp;
            span.apparent
              | Feels like&nbsp;
              span.apparentTemperature
              | &deg;
              span.unit
    .row.bottom
      .corner.left
        .help.code
          .links
            a(href='/app/config')
              | settings 
              i.fas.fa-sliders-h.fa-sm
            a(href='https://github.com/JasonPuglisi/descent' target='_blank')
              | source 
              i.fab.fa-github.fa-sm(aria-hidden='true')
          .menuItem
            button.linkButton(type='button' data-key='w')
              i.fas.fa-sun.fa-sm.fa-fw
              |  [w]eather
          .menuItem
            button.linkButton(type='button' data-key='t')
              i.fas.fa-clock.fa-sm.fa-fw
              |  [t]ime and date
          .menuItem
            button.linkButton(type='button' data-key='e')
              i.fas.fa-sticky-note.fa-sm.fa-fw
              |  [e]xtended info
          .menuItem
            span.hueHelp.hide
              button.linkButton(type='button' data-key='l')
                i.fas.fa-lightbulb.fa-sm.fa-fw
                |  [l]ights (
                span.hueIndicator off
                | )
          .menuItem
            button.linkButton(type='button' data-key='h')
              i.fas.fa-question.fa-sm.fa-fw
              |  [h]elp
      .corner.right
        .music
          h2.userLine.hide
            p.scrobbles.hide
              b
                span.scrobbleCount
              |  scrobbles
            p.detailedScrobbles.hide
              b
                span.artistScrobbleCount
              |  this artist •  
              b
                span.trackScrobbleCount
              |  this track
              span.loved.hide
                | &nbsp;&hearts;
            a.userLink(href=`https://www.last.fm/user/${user}`, target='_blank')
              i.fab.fa-lastfm
              | &nbsp;
              span.user= user
            | &nbsp;is listening to
          a.songLink(href='', target='_blank')
            img.cover
          h1.title
          h2.artist

block otherJavascripts
  +colorThief
  +chroma
  script(type='module', src=`${assets}/javascripts/now.js`)
